# Copy this file to .env and fill in your actual values

# "sample" needs no setup and works immediately — deterministic, zone-specific
# synthetic NDVI data, useful for development and demos.
# "gee" pulls real MODIS NDVI via Google Earth Engine and requires the
# service-account setup described in README.md.
NDVI_SOURCE=sample

PORT=8000

# Only required when NDVI_SOURCE=gee
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=

CLIENT_ORIGIN=http://localhost:5000
