# Copy this file to .env and fill in your actual values
PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string_here
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000

# Email (verification + password reset). Leave SMTP_HOST empty in development
# and a free Ethereal test inbox is used automatically (emails are not
# delivered; a preview link is logged to the console).
# For real delivery for free, use Gmail SMTP with an app password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ReGen Mapper" <no-reply@regenmapper.local>
